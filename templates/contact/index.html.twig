{% extends 'base.html.twig' %}
{% block title %}Contact - Vite & Gourmand{% endblock %}
{% block body %}
<div class="row justify-content-center"><div class="col-lg-7"><div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h3">Contactez-nous</h1>
    <p class="text-muted">Une question sur un menu, une commande ou une prestation ? Envoyez votre demande à Vite & Gourmand.</p>
    {{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-warning w-100">Envoyer la demande</button>{{ form_end(form) }}
</div></div></div></div>
{% endblock %}
