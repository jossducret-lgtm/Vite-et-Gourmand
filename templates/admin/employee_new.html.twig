{% extends 'layouts/backoffice.html.twig' %}
{% block title %}Nouvel employé{% endblock %}
{% block backoffice_body %}
<nav aria-label="Fil d'Ariane" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="{{ path('app_admin_employees') }}">Employés</a></li>
        <li class="breadcrumb-item active">Nouveau</li>
    </ol>
</nav>
<h1 class="page-title mb-4">Créer un compte employé</h1>
<div class="card card-vite"><div class="card-body p-4 p-md-5">
    {{ form_start(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.plainPassword) }}
    <button class="btn btn-vite">Créer le compte</button>
    {{ form_end(form) }}
    <p class="small text-muted mt-3 mb-0">Le mot de passe doit être transmis manuellement à l'employé (non envoyé par email).</p>
</div></div>
{% endblock %}
