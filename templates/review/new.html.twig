{% extends 'base.html.twig' %}
{% block title %}Donner un avis{% endblock %}
{% block body %}
<nav aria-label="Fil d'Ariane" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="{{ path('app_account_orders') }}">Mes commandes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Avis</li>
    </ol>
</nav>
<div class="auth-page auth-page--wide">
    <div class="card card-vite">
        <div class="card-body p-4 p-md-5">
            <h1 class="page-title h3 mb-2">Laisser un avis</h1>
            <p class="text-muted mb-4">Commande <strong>{{ order.orderNumber }}</strong>, menu {{ order.menu.title }}</p>
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-vite w-100 mt-3">Envoyer mon avis</button>
            <a href="{{ path('app_account_order_show', { id: order.id }) }}" class="btn btn-outline-secondary w-100 mt-2">Retour à la commande</a>
            {{ form_end(form) }}
            <p class="small text-muted mt-3 mb-0">L'avis sera visible sur l'accueil après validation.</p>
        </div>
    </div>
</div>
{% endblock %}
