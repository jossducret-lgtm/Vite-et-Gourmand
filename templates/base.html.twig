<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Vite et Gourmand, traiteur à Bordeaux. Commande de menus en ligne.">
    <title>{% block title %}Vite & Gourmand{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
<a href="#main-content" class="skip-link">Aller au contenu principal</a>
<nav class="navbar navbar-expand-lg navbar-dark navbar-vite" aria-label="Navigation principale">
    <div class="container">
        <a href="{{ path('app_home') }}" class="navbar-brand fw-bold">Vite &amp; Gourmand</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="mainNavbar" class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <li class="nav-item"><a href="{{ path('app_home') }}" class="nav-link">Accueil</a></li>
                <li class="nav-item"><a href="{{ path('app_menu_index') }}" class="nav-link">Nos menus</a></li>
                <li class="nav-item"><a href="{{ path('app_contact') }}" class="nav-link">Contact</a></li>
                {% if app.user %}
                    <li class="nav-item"><a href="{{ path('app_account') }}" class="nav-link">Mon compte</a></li>
                    {% if is_granted('ROLE_EMPLOYEE') %}<li class="nav-item"><a href="{{ path('app_employee_dashboard') }}" class="nav-link">Employé</a></li>{% endif %}
                    {% if is_granted('ROLE_ADMIN') %}<li class="nav-item"><a href="{{ path('app_admin_dashboard') }}" class="nav-link">Admin</a></li>{% endif %}
                    <li class="nav-item ms-lg-2"><a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">Déconnexion</a></li>
                {% else %}
                    <li class="nav-item ms-lg-2"><a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Connexion</a></li>
                    <li class="nav-item ms-lg-1"><a href="{{ path('app_register') }}" class="btn btn-vite btn-sm">Créer un compte</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
<main id="main-content" class="flex-grow-1 {% block main_class %}py-4 py-md-5{% endblock %}">
    {% block main_before %}{% endblock %}
    <div class="{% block container_class %}container{% endblock %}">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
    {% block main_after %}{% endblock %}
</main>
<footer class="footer-vite py-5 mt-auto">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <h2 class="h5 mb-3">Vite &amp; Gourmand</h2>
                <p class="small mb-2">12 Quai des Chartrons<br>33000 Bordeaux</p>
                <p class="small mb-0">
                    <a href="mailto:contact@vitegourmand.fr">contact@vitegourmand.fr</a><br>
                    <a href="tel:+33601020304">06 01 02 03 04</a>
                </p>
            </div>
            <div class="col-md-4">
                <h2 class="h6 mb-3">Horaires d'ouverture</h2>
                <ul class="list-unstyled small mb-0">
                    {% set dayLabels = {'LUNDI':'Lundi','MARDI':'Mardi','MERCREDI':'Mercredi','JEUDI':'Jeudi','VENDREDI':'Vendredi','SAMEDI':'Samedi','DIMANCHE':'Dimanche'} %}
                    {% if openingHours is defined and openingHours|length > 0 %}
                        {% for hour in openingHours %}
                            <li class="mb-1">{{ dayLabels[hour.dayOfWeek] ?? hour.dayOfWeek }} :
                                {% if hour.isClosed %}<span class="text-white-50">fermé</span>{% else %}{{ hour.openingTime ? hour.openingTime|date('H\\hi') : '-' }} à {{ hour.closingTime ? hour.closingTime|date('H\\hi') : '-' }}{% endif %}
                            </li>
                        {% endfor %}
                    {% else %}
                        <li>Lun. – ven. : 09h00 – 18h00</li>
                        <li>Samedi : 09h00 – 13h00</li>
                        <li>Dimanche : fermé</li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-md-4">
                <h2 class="h6 mb-3">Liens utiles</h2>
                <a href="{{ path('app_menu_index') }}" class="d-block mb-2">Catalogue des menus</a>
                <a href="{{ path('app_contact') }}" class="d-block mb-2">Nous contacter</a>
                <a href="{{ path('app_legal_mentions') }}" class="d-block mb-1">Mentions légales</a>
                <a href="{{ path('app_legal_cgv') }}" class="d-block mb-1">CGV</a>
                <a href="{{ path('app_legal_privacy') }}" class="d-block">Confidentialité</a>
            </div>
        </div>
        <hr class="border-secondary my-4 opacity-25">
        <p class="small text-center text-white-50 mb-0">&copy; {{ 'now'|date('Y') }} Vite &amp; Gourmand, traiteur à Bordeaux</p>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
