<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Vite & Gourmand{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a href="{{ path('app_home') }}" class="navbar-brand fw-bold">Vite & Gourmand</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="mainNavbar" class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item"><a href="{{ path('app_home') }}" class="nav-link">Accueil</a></li>
                <li class="nav-item"><a href="{{ path('app_menu_index') }}" class="nav-link">Tous les menus</a></li>
                <li class="nav-item"><a href="{{ path('app_contact') }}" class="nav-link">Contact</a></li>
                {% if app.user %}
                    <li class="nav-item"><a href="{{ path('app_account') }}" class="nav-link">Mon compte</a></li>
                    {% if is_granted('ROLE_EMPLOYEE') %}<li class="nav-item"><a href="{{ path('app_employee_dashboard') }}" class="nav-link">Employé</a></li>{% endif %}
                    {% if is_granted('ROLE_ADMIN') %}<li class="nav-item"><a href="{{ path('app_admin_dashboard') }}" class="nav-link">Admin</a></li>{% endif %}
                    <li class="nav-item ms-lg-2"><a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">Déconnexion</a></li>
                {% else %}
                    <li class="nav-item ms-lg-2"><a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Connexion</a></li>
                    <li class="nav-item ms-lg-2"><a href="{{ path('app_register') }}" class="btn btn-warning btn-sm">Créer un compte</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
<main class="flex-grow-1 py-4">
    <div class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</main>
<footer class="bg-dark text-white py-4 mt-auto">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-5">
                <h2 class="h5">Vite & Gourmand</h2>
                <p class="mb-0">Traiteur à Bordeaux depuis 25 ans. Menus pour repas, fêtes, Noël, Pâques et événements.</p>
            </div>
            <div class="col-md-4">
                <h2 class="h6">Horaires</h2>
                <ul class="list-unstyled small mb-0">
                    <li>Lundi au samedi : 09h00 - 18h00</li>
                    <li>Dimanche : fermé</li>
                </ul>
            </div>
            <div class="col-md-3">
                <h2 class="h6">Informations</h2>
                <a href="{{ path('app_legal_mentions') }}" class="text-white d-block">Mentions légales</a>
                <a href="{{ path('app_legal_cgv') }}" class="text-white d-block">Conditions générales de vente</a>
            </div>
        </div>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
