{% extends 'base.html.twig' %}
{% block title %}Commande {{ order.orderNumber }}{% endblock %}
{% block body %}
{% include 'partials/order_status_labels.html.twig' %}
<nav aria-label="Fil d'Ariane" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="{{ path('app_account') }}">Mon compte</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_account_orders') }}">Commandes</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ order.orderNumber }}</li>
    </ol>
</nav>

<h1 class="page-title mb-4">Commande {{ order.orderNumber }}</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card card-vite">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 page-title mb-0">{{ order.menu.title }}</h2>
                    <span class="badge badge-status badge-status--pending">{{ order_status_labels[order.status] ?? order.status }}</span>
                </div>
                <dl class="row small mb-0">
                    <dt class="col-sm-4 text-muted">Date</dt><dd class="col-sm-8">{{ order.serviceDate|date('d/m/Y') }} à {{ order.deliveryTime|date('H:i') }}</dd>
                    <dt class="col-sm-4 text-muted">Livraison</dt><dd class="col-sm-8">{{ order.deliveryAddress }}, {{ order.deliveryCity }}{% if order.deliveryPlace %} ({{ order.deliveryPlace }}){% endif %}</dd>
                    <dt class="col-sm-4 text-muted">Personnes</dt><dd class="col-sm-8">{{ order.peopleCount }}</dd>
                </dl>
                <hr>
                <div class="price-recap p-3">
                    <div class="d-flex justify-content-between mb-1"><span>Prix menu</span><span>{{ order.menuPrice|number_format(2, ',', ' ') }} €</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Réduction</span><span>-{{ order.discountAmount|number_format(2, ',', ' ') }} €</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Livraison</span><span>{{ order.deliveryPrice|number_format(2, ',', ' ') }} €</span></div>
                    <div class="d-flex justify-content-between price-recap__total"><strong>Total</strong><strong>{{ order.totalPrice|number_format(2, ',', ' ') }} €</strong></div>
                </div>
                {% if order.status == 'EN_ATTENTE' %}
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a href="{{ path('app_account_order_edit', { id: order.id }) }}" class="btn btn-outline-vite">Modifier</a>
                        <form method="post" action="{{ path('app_account_order_cancel', { id: order.id }) }}" onsubmit="return confirm('Annuler cette commande ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ order.id) }}">
                            <button class="btn btn-outline-danger">Annuler la commande</button>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="card card-vite mt-4">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Avis</h2>
                {% if order.review %}
                    <p class="rating-stars mb-2">{% for i in 1..5 %}{% if i <= order.review.rating %}★{% else %}☆{% endif %}{% endfor %}</p>
                    <p class="mb-2">« {{ order.review.comment }} »</p>
                    {% if order.review.status == 'PENDING' %}
                        <span class="badge badge-status badge-status--warning">En attente de validation</span>
                    {% elseif order.review.status == 'VALIDATED' %}
                        <span class="badge badge-status badge-status--success">Publié sur l'accueil</span>
                    {% else %}
                        <span class="badge badge-status badge-status--danger">Non publié</span>
                    {% endif %}
                {% elseif order.canReceiveReview %}
                    <p class="text-muted small mb-2">Commande terminée ? Vous pouvez laisser un avis.</p>
                    <a href="{{ path('app_review_new', { id: order.id }) }}" class="btn btn-vite">Donner mon avis</a>
                {% else %}
                    <p class="text-muted small mb-0">L'avis sera disponible une fois la commande livrée.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-vite">
            <div class="card-body p-4">
                <h2 class="h6 text-muted text-uppercase mb-3">Suivi</h2>
                <ul class="status-timeline">
                    {% for history in order.statusHistories %}
                        <li class="status-timeline__item{% if loop.first %} status-timeline__item--active{% endif %}">
                            <strong>{{ order_status_labels[history.status] ?? history.status }}</strong>
                            <div class="status-timeline__date">{{ history.createdAt|date('d/m/Y à H:i') }}</div>
                            {% if history.comment %}<p class="small mb-0 mt-1">{{ history.comment }}</p>{% endif %}
                        </li>
                    {% else %}
                        <li class="text-muted small">Aucun historique.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
