{% extends 'base.html.twig' %}
{% block title %}Commande {{ order.orderNumber }}{% endblock %}
{% block body %}
<h1 class="fw-bold mb-4">Commande {{ order.orderNumber }}</h1>
<div class="row g-4"><div class="col-lg-7"><div class="card shadow-sm"><div class="card-body">
    <h2 class="h5">Détail de la commande</h2>
    <p><strong>Menu :</strong> {{ order.menu.title }}</p><p><strong>Date :</strong> {{ order.serviceDate|date('d/m/Y') }}</p><p><strong>Heure :</strong> {{ order.deliveryTime|date('H:i') }}</p><p><strong>Lieu :</strong> {{ order.deliveryPlace ?: 'Non précisé' }}</p><p><strong>Adresse :</strong> {{ order.deliveryAddress }}, {{ order.deliveryCity }}</p><p><strong>Nombre de personnes :</strong> {{ order.peopleCount }}</p><p><strong>Statut :</strong> <span class="badge bg-secondary">{{ order.status }}</span></p><hr>
    <p><strong>Prix menu :</strong> {{ order.menuPrice|number_format(2, ',', ' ') }} €</p><p><strong>Réduction :</strong> -{{ order.discountAmount|number_format(2, ',', ' ') }} €</p><p><strong>Livraison :</strong> {{ order.deliveryPrice|number_format(2, ',', ' ') }} €</p><p class="fs-5"><strong>Total :</strong> {{ order.totalPrice|number_format(2, ',', ' ') }} €</p>
    {% if order.status == 'EN_ATTENTE' %}<a href="{{ path('app_account_order_edit', { id: order.id }) }}" class="btn btn-outline-dark me-2">Modifier</a><form method="post" action="{{ path('app_account_order_cancel', { id: order.id }) }}" class="d-inline" onsubmit="return confirm('Annuler cette commande ?');"><input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ order.id) }}"><button class="btn btn-danger">Annuler</button></form>{% endif %}
    {% if order.status == 'TERMINEE' and not order.review %}<a href="{{ path('app_review_new', { id: order.id }) }}" class="btn btn-warning mt-3">Donner mon avis</a>{% endif %}
</div></div></div><div class="col-lg-5"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Suivi de la commande</h2>{% for history in order.statusHistories %}<div class="border-start border-3 ps-3 mb-3"><strong>{{ history.status }}</strong><br><small class="text-muted">{{ history.createdAt|date('d/m/Y H:i') }}</small>{% if history.comment %}<p class="mb-0">{{ history.comment }}</p>{% endif %}</div>{% else %}<p class="text-muted">Aucun historique disponible.</p>{% endfor %}</div></div></div></div>
{% endblock %}
