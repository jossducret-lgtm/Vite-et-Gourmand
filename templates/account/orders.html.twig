{% extends 'base.html.twig' %}
{% block title %}Mes commandes{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="fw-bold mb-0">Mes commandes</h1><a href="{{ path('app_menu_index') }}" class="btn btn-warning">Commander un menu</a></div>
{% if orders is empty %}<div class="alert alert-info">Vous n’avez pas encore passé de commande.</div>{% else %}
<div class="table-responsive bg-white rounded shadow-sm"><table class="table table-hover align-middle mb-0"><thead><tr><th>Numéro</th><th>Menu</th><th>Date prestation</th><th>Statut</th><th>Total</th><th></th></tr></thead><tbody>{% for order in orders %}<tr><td>{{ order.orderNumber }}</td><td>{{ order.menu.title }}</td><td>{{ order.serviceDate|date('d/m/Y') }}</td><td><span class="badge bg-secondary">{{ order.status }}</span></td><td>{{ order.totalPrice|number_format(2, ',', ' ') }} €</td><td class="text-end"><a href="{{ path('app_account_order_show', { id: order.id }) }}" class="btn btn-sm btn-outline-dark">Détail</a></td></tr>{% endfor %}</tbody></table></div>
{% endif %}
{% endblock %}
