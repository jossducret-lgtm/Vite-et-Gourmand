{% extends 'base.html.twig' %}
{% block title %}Commandes - Employé{% endblock %}
{% block body %}
<h1 class="fw-bold mb-4">Commandes à traiter</h1>
<form method="get" class="card card-body shadow-sm mb-4"><div class="row g-3 align-items-end"><div class="col-md-4"><label for="status" class="form-label">Statut</label><select id="status" name="status" class="form-select"><option value="">Tous les statuts</option>{% for status in statuses %}<option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>{% endfor %}</select></div><div class="col-md-5"><label for="customer" class="form-label">Client</label><input id="customer" name="customer" class="form-control" value="{{ filters.customer }}" placeholder="Nom, prénom ou email"></div><div class="col-md-3"><button class="btn btn-dark w-100">Filtrer</button></div></div></form>
<div class="table-responsive bg-white rounded shadow-sm"><table class="table table-hover align-middle mb-0"><thead><tr><th>Commande</th><th>Client</th><th>Menu</th><th>Date</th><th>Statut</th><th>Changer</th></tr></thead><tbody>{% for order in orders %}<tr><td>{{ order.orderNumber }}</td><td>{{ order.user.firstName }} {{ order.user.lastName }}<br><small>{{ order.user.email }}</small></td><td>{{ order.menu.title }}</td><td>{{ order.serviceDate|date('d/m/Y') }}</td><td><span class="badge bg-secondary">{{ order.status }}</span></td><td><form method="post" action="{{ path('app_employee_order_status', { id: order.id }) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('employee_order_status_' ~ order.id) }}"><div class="col-md-4"><select name="status" class="form-select form-select-sm">{% for status in statuses %}<option value="{{ status }}">{{ status }}</option>{% endfor %}</select></div><div class="col-md-4"><input name="comment" class="form-control form-control-sm" placeholder="Commentaire"></div><div class="col-md-2"><select name="cancellationContactMode" class="form-select form-select-sm"><option value="">Contact</option><option value="TELEPHONE">Téléphone</option><option value="EMAIL">Email</option></select></div><div class="col-md-2"><button class="btn btn-sm btn-warning w-100">OK</button></div><div class="col-12"><input name="cancellationReason" class="form-control form-control-sm" placeholder="Motif si annulation"></div></form></td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted">Aucune commande trouvée.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
