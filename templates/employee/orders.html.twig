{% extends 'layouts/backoffice.html.twig' %}
{% block title %}Commandes{% endblock %}
{% block backoffice_body %}
{% include 'partials/order_status_labels.html.twig' %}
<h1 class="page-title mb-1">Commandes clients</h1>
<p class="text-muted mb-4">Changer le statut des commandes clients.</p>

<form method="get" class="card card-vite mb-4"><div class="card-body">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="status" class="form-label">Statut</label>
            <select id="status" name="status" class="form-select">
                <option value="">Tous les statuts</option>
                {% for status in statuses %}
                    <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ order_status_labels[status] ?? status }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-5">
            <label for="customer" class="form-label">Rechercher un client</label>
            <input id="customer" name="customer" class="form-control" value="{{ filters.customer }}" placeholder="Nom, prénom ou email">
        </div>
        <div class="col-md-3"><button class="btn btn-vite w-100">Filtrer</button></div>
    </div>
</div></form>

{% for order in orders %}
    <div class="card card-vite mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-4">
                    <strong>{{ order.orderNumber }}</strong>
                    <span class="badge badge-status badge-status--pending ms-1">{{ order_status_labels[order.status] ?? order.status }}</span>
                    <p class="small text-muted mb-1 mt-2">{{ order.user.firstName }} {{ order.user.lastName }}</p>
                    <p class="small mb-0">{{ order.user.email }}</p>
                </div>
                <div class="col-lg-3">
                    <p class="small mb-1"><strong>{{ order.menu.title }}</strong></p>
                    <p class="small text-muted mb-0">{{ order.serviceDate|date('d/m/Y') }}, {{ order.peopleCount }} pers., {{ order.totalPrice|number_format(2, ',', ' ') }} €</p>
                </div>
                <div class="col-lg-5">
                    <form method="post" action="{{ path('app_employee_order_status', { id: order.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('employee_order_status_' ~ order.id) }}">
                        <div class="row g-2">
                            <div class="col-12">
                                <select name="status" class="form-select form-select-sm">
                                    {% for status in statuses %}
                                        <option value="{{ status }}" {% if order.status == status %}selected{% endif %}>{{ order_status_labels[status] ?? status }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-12"><input name="comment" class="form-control form-control-sm" placeholder="Commentaire (visible client dans le suivi)"></div>
                            <div class="col-md-6">
                                <select name="cancellationContactMode" class="form-select form-select-sm">
                                    <option value="">Mode contact si annulation</option>
                                    <option value="TELEPHONE">Téléphone</option>
                                    <option value="EMAIL">Email</option>
                                </select>
                            </div>
                            <div class="col-md-6"><button class="btn btn-sm btn-vite w-100">Mettre à jour</button></div>
                            <div class="col-12"><input name="cancellationReason" class="form-control form-control-sm" placeholder="Motif d'annulation (obligatoire si statut Annulée)"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="alert alert-light border text-center py-4">Aucune commande ne correspond aux filtres.</div>
{% endfor %}
{% endblock %}
