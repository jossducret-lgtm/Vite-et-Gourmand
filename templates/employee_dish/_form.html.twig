{{ form_start(form, { attr: { enctype: 'multipart/form-data' } }) }}
<div class="row g-3">
    <div class="col-md-8">{{ form_row(form.title) }}</div>
    <div class="col-md-4">{{ form_row(form.type) }}</div>
    <div class="col-12">{{ form_row(form.description) }}</div>
    <div class="col-md-6">{{ form_row(form.photoFile) }}</div>
    <div class="col-md-6">{{ form_row(form.isActive) }}</div>
    <div class="col-12">
        <fieldset class="border rounded p-3">
            <legend class="float-none w-auto px-2 small text-muted text-uppercase">Allergènes</legend>
            {{ form_row(form.allergens) }}
        </fieldset>
    </div>
</div>
<div class="d-flex flex-wrap gap-2 mt-3">
    <button class="btn btn-vite" type="submit">Enregistrer le plat</button>
    <a href="{{ path('app_employee_dish_index') }}" class="btn btn-outline-secondary">Retour</a>
</div>
{{ form_end(form) }}
