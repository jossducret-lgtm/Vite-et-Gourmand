{% extends 'base.html.twig' %}

{% block title %}Dish{% endblock %}

{% block body %}
    <h1>Dish</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ dish.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ dish.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ dish.description }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>{{ dish.photo }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ dish.type }}</td>
            </tr>
            <tr>
                <th>IsActive</th>
                <td>{{ dish.isActive ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ dish.createdAt ? dish.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ dish.updatedAt ? dish.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_employee_dish_index') }}">back to list</a>

    <a href="{{ path('app_employee_dish_edit', {'id': dish.id}) }}">edit</a>

    {{ include('employee_dish/_delete_form.html.twig') }}
{% endblock %}
