{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body %}
<div class="auth-page">
    <div class="card card-vite">
        <div class="card-body p-4 p-md-5">
            <h1 class="page-title h3 mb-2">Mot de passe oublié</h1>
            <p class="text-muted mb-4">Saisissez votre email pour recevoir un lien de réinitialisation.</p>
            {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}
            <button class="btn btn-vite w-100 mt-2">Recevoir le lien</button>
            {{ form_end(requestForm) }}
            <p class="text-center small mt-3 mb-0"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
        </div>
    </div>
</div>
{% endblock %}
