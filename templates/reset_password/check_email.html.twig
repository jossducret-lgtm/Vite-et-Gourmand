{% extends 'base.html.twig' %}
{% block title %}Email envoyé{% endblock %}
{% block body %}
<div class="auth-page">
    <div class="card card-vite">
        <div class="card-body p-4 p-md-5 text-center">
            <h1 class="page-title h3 mb-3">Vérifiez votre boîte mail</h1>
            <p class="text-muted">Si un compte existe pour cette adresse, un lien de réinitialisation vient d'être envoyé.</p>
            <p class="small text-muted">Le lien expire dans 1 heure. Pensez à vérifier vos spams.</p>
            <a href="{{ path('app_login') }}" class="btn btn-vite mt-3">Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
