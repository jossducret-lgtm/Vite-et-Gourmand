{% extends 'layouts/backoffice.html.twig' %}
{% block title %}Modifier menu{% endblock %}
{% block backoffice_body %}
<h1 class="page-title mb-4">Modifier {{ menu.title }}</h1>

{% if menu.images|length > 0 %}
    <div class="card card-vite mb-4"><div class="card-body">
        <h2 class="h6">Galerie actuelle</h2>
        <div class="row g-3">
            {% for image in menu.images %}
                <div class="col-md-3">
                    <div class="border rounded p-2 bg-light">
                        <img src="{{ asset('uploads/' ~ image.filename) }}" alt="{{ image.altText ?: menu.title }}" class="img-fluid rounded mb-2">
                        <form method="post" action="{{ path('app_employee_menu_image_delete', { id: menu.id, imageId: image.id }) }}" onsubmit="return confirm('Supprimer cette image ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_image_' ~ image.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div></div>
{% endif %}

<div class="card card-vite"><div class="card-body p-4">{{ include('employee_menu/_form.html.twig', { menu: menu, showGallery: false }) }}</div></div>
{% endblock %}
