{% extends 'base.html.twig' %}
{% block title %}Commander {{ menu.title }}{% endblock %}
{% block body %}
<nav aria-label="Fil d'Ariane" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="{{ path('app_menu_index') }}">Menus</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_menu_show', { slug: menu.slug }) }}">{{ menu.title }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">Commander</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card card-vite">
            <div class="card-body p-4 p-md-5">
                <h1 class="page-title h3 mb-3">{% if order is defined %}Modifier{% else %}Commander{% endif %} : {{ menu.title }}</h1>

                <div class="alert alert-conditions mb-4" role="note">
                    <strong>Conditions :</strong> {{ menu.conditionsText ?: 'Aucune condition particulière.' }}
                </div>

                <div class="card bg-light border-0 mb-4">
                    <div class="card-body py-3">
                        <h2 class="h6 mb-2">Client connecté</h2>
                        <p class="mb-0 small">{{ app.user.firstName }} {{ app.user.lastName }}, {{ app.user.email }}, {{ app.user.phone }}</p>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-4"><div class="text-center p-3 border rounded bg-white"><span class="d-block small text-muted">Minimum</span><strong>{{ menu.minPeople }} pers.</strong></div></div>
                    <div class="col-4"><div class="text-center p-3 border rounded bg-white"><span class="d-block small text-muted">Prix</span><strong>{{ menu.pricePerPerson|number_format(2, ',', ' ') }} €</strong>/pers.</div></div>
                    <div class="col-4"><div class="text-center p-3 border rounded bg-white"><span class="d-block small text-muted">Réduction</span><strong>-10%</strong> dès {{ menu.minPeople + 5 }} pers.</div></div>
                </div>

                {% set maxPeople = order is defined ? menu.stockQuantity + order.peopleCount : menu.stockQuantity %}
                {{ form_start(form) }}
                <h2 class="h6 mb-3">Livraison</h2>
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.serviceDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.deliveryTime) }}</div>
                    <div class="col-md-8">{{ form_row(form.deliveryAddress) }}</div>
                    <div class="col-md-4">{{ form_row(form.deliveryCity) }}</div>
                    <div class="col-md-8">{{ form_row(form.deliveryPlace) }}</div>
                    <div class="col-md-4">{{ form_row(form.distanceKm) }}</div>
                    <div class="col-md-4">{{ form_row(form.peopleCount) }}</div>
                </div>

                <div id="orderCalculator"
                     data-min-people="{{ menu.minPeople }}"
                     data-max-people="{{ maxPeople }}"
                     data-price-per-person="{{ menu.pricePerPerson }}"
                     class="price-recap p-4 mt-4">
                    <h2 class="h6 text-muted text-uppercase mb-3">Récapitulatif</h2>
                    <div class="d-flex justify-content-between mb-1"><span>Prix menu</span><span><span id="menuPricePreview">{{ priceDetails.menuPrice|number_format(2, ',', ' ') }}</span> €</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Réduction</span><span>-<span id="discountPreview">{{ priceDetails.discountAmount|number_format(2, ',', ' ') }}</span> €</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Livraison</span><span><span id="deliveryPreview">{{ priceDetails.deliveryPrice|number_format(2, ',', ' ') }}</span> €</span></div>
                    <div class="d-flex justify-content-between price-recap__total"><strong>Total</strong><strong><span id="totalPreview">{{ priceDetails.totalPrice|number_format(2, ',', ' ') }}</span> €</strong></div>
                    <p id="peopleWarning" class="text-danger small mt-2 d-none mb-0"></p>
                </div>

                <button type="submit" id="orderSubmitBtn" class="btn btn-vite btn-lg w-100 mt-4">
                    {% if order is defined %}Enregistrer les modifications{% else %}Confirmer la commande{% endif %}
                </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
<script>
const calculator = document.querySelector('#orderCalculator');
if (calculator) {
    const minPeople = Number(calculator.dataset.minPeople);
    const maxPeople = Number(calculator.dataset.maxPeople);
    const pricePerPerson = Number(calculator.dataset.pricePerPerson);
    const peopleInput = document.querySelector('[name$="[peopleCount]"]');
    const cityInput = document.querySelector('[name$="[deliveryCity]"]');
    const distanceInput = document.querySelector('[name$="[distanceKm]"]');
    const menuPricePreview = document.querySelector('#menuPricePreview');
    const discountPreview = document.querySelector('#discountPreview');
    const deliveryPreview = document.querySelector('#deliveryPreview');
    const totalPreview = document.querySelector('#totalPreview');
    const peopleWarning = document.querySelector('#peopleWarning');
    const submitBtn = document.querySelector('#orderSubmitBtn');
    function formatPrice(value) { return value.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function setInvalidPreview(message) {
        menuPricePreview.textContent = '--';
        discountPreview.textContent = '--';
        deliveryPreview.textContent = '--';
        totalPreview.textContent = '--';
        peopleWarning.textContent = message;
        peopleWarning.classList.remove('d-none');
        if (submitBtn) submitBtn.disabled = true;
    }
    function updatePrice() {
        const peopleCount = Number(peopleInput.value || 0);
        if (peopleCount < minPeople) {
            setInvalidPreview('Minimum : ' + minPeople + ' personnes.');
            return;
        }
        if (peopleCount > maxPeople) {
            setInvalidPreview('Stock max. : ' + maxPeople + ' couvert(s).');
            return;
        }
        peopleWarning.classList.add('d-none');
        if (submitBtn) submitBtn.disabled = false;
        const city = (cityInput.value || '').trim().toLowerCase();
        const distanceKm = Number(distanceInput.value || 0);
        let menuPrice = peopleCount * pricePerPerson;
        let discount = peopleCount >= minPeople + 5 ? menuPrice * 0.10 : 0;
        let delivery = city !== '' && city !== 'bordeaux' ? 5 + (distanceKm * 0.59) : 0;
        menuPricePreview.textContent = formatPrice(menuPrice);
        discountPreview.textContent = formatPrice(discount);
        deliveryPreview.textContent = formatPrice(delivery);
        totalPreview.textContent = formatPrice(menuPrice - discount + delivery);
    }
    peopleInput.addEventListener('input', updatePrice);
    cityInput.addEventListener('input', updatePrice);
    if (distanceInput) distanceInput.addEventListener('input', updatePrice);
    updatePrice();
}
</script>
{% endblock %}
