{% extends 'layouts/backoffice.html.twig' %}
{% block title %}Horaires{% endblock %}
{% block backoffice_body %}
{% set dayLabels = {'LUNDI':'Lundi','MARDI':'Mardi','MERCREDI':'Mercredi','JEUDI':'Jeudi','VENDREDI':'Vendredi','SAMEDI':'Samedi','DIMANCHE':'Dimanche'} %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title mb-1">Horaires d'ouverture</h1>
        <p class="text-muted small mb-0">Affichés dans le pied de page du site.</p>
    </div>
    <a href="{{ path('app_employee_opening_hour_new') }}" class="btn btn-vite">Ajouter un créneau</a>
</div>
<div class="table-responsive card card-vite">
    <table class="table table-vite table-hover mb-0 align-middle">
        <thead><tr><th>Jour</th><th>Ouverture</th><th>Fermeture</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        {% for hour in opening_hours %}
            <tr>
                <td><strong>{{ dayLabels[hour.dayOfWeek] ?? hour.dayOfWeek }}</strong></td>
                <td>{% if hour.isClosed %}<span class="text-muted">Fermé</span>{% else %}{{ hour.openingTime ? hour.openingTime|date('H\\hi') : '-' }}{% endif %}</td>
                <td>{% if hour.isClosed %}-{% else %}{{ hour.closingTime ? hour.closingTime|date('H\\hi') : '-' }}{% endif %}</td>
                <td class="text-end"><a href="{{ path('app_employee_opening_hour_edit', { id: hour.id }) }}" class="btn btn-sm btn-outline-dark">Modifier</a></td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-center text-muted py-4">Aucun horaire configuré.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
