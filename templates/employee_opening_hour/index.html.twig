{% extends 'base.html.twig' %}

{% block title %}OpeningHour index{% endblock %}

{% block body %}
    <h1>OpeningHour index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DayOfWeek</th>
                <th>OpeningTime</th>
                <th>ClosingTime</th>
                <th>IsClosed</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for opening_hour in opening_hours %}
            <tr>
                <td>{{ opening_hour.id }}</td>
                <td>{{ opening_hour.dayOfWeek }}</td>
                <td>{{ opening_hour.openingTime ? opening_hour.openingTime|date('H:i:s') : '' }}</td>
                <td>{{ opening_hour.closingTime ? opening_hour.closingTime|date('H:i:s') : '' }}</td>
                <td>{{ opening_hour.isClosed ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_employee_opening_hour_show', {'id': opening_hour.id}) }}">show</a>
                    <a href="{{ path('app_employee_opening_hour_edit', {'id': opening_hour.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_employee_opening_hour_new') }}">Create new</a>
{% endblock %}
